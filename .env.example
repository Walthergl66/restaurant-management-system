# Configuración local de Docker Compose. Copia a .env y completa los valores.
# No agregues secretos aquí ni subas el archivo .env.

# PostgreSQL externo. El backend usa host.docker.internal si la BD está
# instalada en el mismo equipo que Docker; para otro servidor usa su DNS/IP.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=restaurante
DB_USER=restaurante
DB_PASSWORD=cambia-esta-clave
DB_SSLMODE=require

# Puertos publicados en el equipo local.
BACKEND_PORT=8080
FRONTEND_PORT=7070

# Cuenta administradora inicial (solo se usa si no existe un rol ADMIN).
ADMIN_INITIAL_EMAIL=admin@tudominio.com
ADMIN_INITIAL_PASSWORD=cambia-esta-clave

# Perfil Spring que se activa en el backend de Compose.
SPRING_PROFILES_ACTIVE=dev
