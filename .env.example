# Docker Compose local. Copiar a .env EN LA RAIZ del repositorio solo si no existe.
# Si ya existe, incorporar las variables nuevas sin reemplazar claves ni contrasenas.
# Guia: docs/archivos-ubuntu.md y docs/variables-entorno.md
# JWT_SECRET y ADMIN_INITIAL_PASSWORD se configuran en backend/.env.

# PostgreSQL: estos valores gobiernan postgres y backend en docker-compose.yml.
# POSTGRES_DB crea esta base solo al inicializar un volumen vacio.
DB_NAME=restaurante_archivos
DB_USER=restaurante
DB_PASSWORD=cambia-esta-clave
DB_PORT=5432
DB_HOST_PORT=5432
DB_SSLMODE=disable

# Backend dentro del contenedor: perfil dev y puerto interno 8080.
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# Activar DESPUES de preparar Ubuntu y comprobar la conexion SFTP.
ARCHIVOS_HABILITADO=false
ARCHIVOS_HOST=192.168.100.77
ARCHIVOS_PUERTO=22
ARCHIVOS_USUARIO=archivosapp
ARCHIVOS_DIRECTORIO=/srv/restaurante/media
ARCHIVOS_LECTURA_URL=http://192.168.100.77/media/
ARCHIVOS_TIMEOUT=15s

# Solo para el complemento docker-compose.archivos.yml.
# En ese complemento esta variable prevalece sobre DB_NAME para el backend.
# Mantener ambos nombres iguales si se usa el mismo PostgreSQL.
ARCHIVOS_DB_NAME=restaurante_archivos

# No definir rutas Windows para las claves de Docker aqui.
# El compose monta backend/.local/ssh/ en /run/archivos/ (solo lectura) y fija:
# ARCHIVOS_CLAVE_PRIVADA=/run/archivos/archivos_backend
# ARCHIVOS_KNOWN_HOSTS=/run/archivos/known_hosts
