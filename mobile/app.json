{
  "expo": {
    "name": "Estación Burger",
    "slug": "estacion-burger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/brand-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "splash": {
      "image": "./public/Estacion-Burger-Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.estacionburger.app"
    },
    "android": {
      "package": "com.estacionburger.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./public/brand-adaptive.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "//": "react-native-maps en Android usa Google Maps. Coloca aqui la API key real de Google Maps (restringida por package name + SHA-1) antes de generar el development/production build. NO la subas al repo; usa una variable de entorno o EAS secret.",
          "apiKey": "REEMPLAZAR_CON_GOOGLE_MAPS_ANDROID_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./public/brand-favicon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:8080/api/v1"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Estación Burger usa tu ubicación para mostrar tu posición en el mapa y guiar las entregas mientras repartes."
        }
      ]
    ],
    "scheme": "estacionburger"
  }
}
