# Copia a mobile/.env. Expo carga las variables desde este componente.
# Vacío: detectar la IP de Expo y usar el backend en el puerto 8080.
# Para APK/IPA define una URL HTTPS accesible desde el teléfono.
EXPO_PUBLIC_API_URL=

# Token público de Mapbox para los mapas. Se incluye en la app.
EXPO_PUBLIC_MAPBOX_TOKEN=
# No colocar secretos de backend (JWT, Brevo, ORS, PostgreSQL) aquí.
