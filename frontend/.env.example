# Copiar a frontend/.env.local en instalaciones nuevas.
# URL del BACKEND Spring Boot, accesible desde el proceso Next.js.
# No usar aqui la IP de Ubuntu/Nginx, salvo que el backend tambien corra alli.
# No agregar /api/v1: Next.js reenvia /api/* automaticamente.
# Despues de cambiarla, reiniciar npm run dev (o reconstruir en produccion).
# El frontend no necesita usuario SFTP, claves SSH ni ARCHIVOS_*.
BACKEND_URL=http://localhost:8080
