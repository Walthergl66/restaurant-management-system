# ==============================================================================
# Plantilla de variables de entorno.
# Copiala y completala:   cp backend/.env.example backend/.env
# El archivo .env está gitignored. NO subas secretos al repositorio.
# Docker Compose local tambien usa .env en la RAIZ: ver ../.env.example.
# Referencia de variables: ../docs/variables-entorno.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurante_archivos
DB_USER=restaurante
DB_PASSWORD=cambia-esta-clave
DB_SSLMODE=disable
# disable es para PostgreSQL local del compose. Para una BD remota con TLS, require.
# DB_PORT debe ser el puerto del host si Java se ejecuta fuera de Docker.

# ------------------------------------------------------------------------------
# Backend (Spring Boot / Docker)
# ------------------------------------------------------------------------------

# Perfil activo. IMPORTANTE: dejarlo aquí NO activa el perfil (el perfil se
# decide antes de procesar este archivo). Pásalo como variable real:
#   SPRING_PROFILES_ACTIVE=dev ./mvnw spring-boot:run
# En PowerShell, antes de Maven: $env:SPRING_PROFILES_ACTIVE = "dev"
#
# Sin perfil la app arranca igual, pero en modo fail-closed: sin Swagger,
# sin /actuator/metrics, sin CORS y con /actuator/health sin detalles.
#
#   dev  = desarrollo local (Swagger, métricas, CORS abierto)
#   prod = producción (exige todas las variables obligatorias de abajo)
# SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8080

# Contraseña del primer usuario 'admin'. Solo se consume si aún no existe
# ningún ADMIN. En 'prod' es obligatoria y no tiene valor por defecto.
ADMIN_INITIAL_PASSWORD=cambia-esta-clave

# Secreto de firma del JWT. OBLIGATORIO en todos los perfiles: sin él
# la aplicación se niega a arrancar. Mínimo 32 caracteres; se recomienda 64.
#
# Genera uno propio, nunca reutilices el de otra instalación:
#     openssl rand -hex 64
#
# Si cambia, invalida todos los tokens emitidos (los usuarios deben entrar de nuevo).
JWT_SECRET=

# ------------------------------------------------------------------------------
# Almacenamiento en Ubuntu: SFTP para escritura y Nginx para lectura.
# ------------------------------------------------------------------------------
# Activar solo despues de preparar el usuario y la clave SSH en Ubuntu.
# Con Docker, editar .env de la RAIZ para habilitado/host/usuario/lectura-url:
# environment del compose prevalece sobre env_file de este archivo.
ARCHIVOS_HABILITADO=false
ARCHIVOS_HOST=192.168.100.77
ARCHIVOS_PUERTO=22
ARCHIVOS_USUARIO=archivosapp

# Ejecucion NATIVA de Java: rutas absolutas del equipo donde corre Java.
# Usar barras / en Windows. No copiar la clave privada a Ubuntu.
# Ejemplo: C:/ruta/al/proyecto/backend/.local/ssh/archivos_backend
ARCHIVOS_CLAVE_PRIVADA=
# Ejemplo: C:/ruta/al/proyecto/backend/.local/ssh/known_hosts
ARCHIVOS_KNOWN_HOSTS=

# Ejecucion en DOCKER: el compose fija /run/archivos/archivos_backend y
# /run/archivos/known_hosts; monta backend/.local/ssh/ en esa carpeta.
# Las dos variables anteriores pueden permanecer vacias en backend/.env.

# Ruta fisica DENTRO DE UBUNTU. No es una carpeta de Windows ni del backend.
ARCHIVOS_DIRECTORIO=/srv/restaurante/media
# URL que el backend usa para leer Nginx. Debe corresponder al alias /media/.
# Conservar /media/; no agregar /api/v1 y no colocar una URL de producto aqui.
ARCHIVOS_LECTURA_URL=http://192.168.100.77/media/
# Tiempo de espera de conexion y de operaciones de red, no limite del archivo.
ARCHIVOS_TIMEOUT=15s

# Ventana de vida del token de acceso, en milisegundos (1 hora por defecto).
JWT_EXPIRATION_MS=3600000

# Origenes permitidos para navegador, separados por coma. * es solo para dev.
# Una lista vacia bloquea los origenes de navegador. En prod es obligatoria sin *.
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# Correo transaccional (Brevo)
# ------------------------------------------------------------------------------
# Envío de códigos de verificación de correo y recuperación de contraseña.
#
# En desarrollo y pruebas mantener desactivado.
# En producción se requiere configurar Brevo.
BREVO_HABILITADO=false

# Clave de API de Brevo.
BREVO_API_KEY=

# Correo electrónico del remitente verificado.
BREVO_REMITENTE_EMAIL=

# Nombre visible del remitente.
BREVO_REMITENTE_NOMBRE=Estación Burger

# Tiempo máximo de espera.
BREVO_TIMEOUT=5s
