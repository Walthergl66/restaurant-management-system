# ==============================================================================
# Plantilla de variables de entorno.
# Copiala y completala:   cp backend/.env.example backend/.env
# El archivo .env está gitignored. NO subas secretos al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurante
DB_USER=restaurante
DB_PASSWORD=cambia-esta-clave

# ------------------------------------------------------------------------------
# Backend (Spring Boot / Docker)
# ------------------------------------------------------------------------------

# Perfil activo. IMPORTANTE: dejarlo aquí NO activa el perfil (el perfil se
# decide antes de procesar este archivo). Pásalo como variable real:
#   SPRING_PROFILES_ACTIVE=dev ./mvnw spring-boot:run
# o usa ./scripts/run-backend.sh, que exporta este archivo al entorno.
#
# Sin perfil la app arranca igual, pero en modo fail-closed: sin Swagger,
# sin /actuator/metrics, sin CORS y con /actuator/health sin detalles.
#
#   dev  = desarrollo local (Swagger, métricas, CORS abierto)
#   prod = producción (exige todas las variables obligatorias de abajo)
# SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8080

# Contraseña del primer usuario 'admin'. Solo se consume si aún no existe
# ningún ADMIN. En 'prod' es obligatoria y no tiene valor por defecto.
ADMIN_INITIAL_PASSWORD=cambia-esta-clave

# Secreto de firma del JWT (HS512). OBLIGATORIO en todos los perfiles: sin él
# la aplicación se niega a arrancar. Mínimo 32 caracteres; se recomienda 64.
#
# Genera uno propio, nunca reutilices el de otra instalación:
#     openssl rand -hex 64
#
# Si cambia, invalida todos los tokens emitidos (los usuarios deben entrar de nuevo).
JWT_SECRET=

# Ventana de vida del token de acceso, en milisegundos (1 hora por defecto).
JWT_EXPIRATION_MS=3600000

# Orígenes permitidos para navegador, separados por coma. Sin valor = todos (solo
# aceptable en desarrollo). En 'prod' es obligatoria y NO puede ser '*'.
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# Correo transaccional (Brevo)
# ------------------------------------------------------------------------------
# Envío de códigos de verificación de correo y de recuperación de contraseña.
#
# En desarrollo y pruebas déjalo desactivado: los códigos se escriben en el
# log del backend (entrega manual). En 'prod' el perfil fuerza habilitado=true
# y la app no arranca sin BREVO_API_KEY ni BREVO_REMITENTE_EMAIL.
BREVO_HABILITADO=false

# Clave de la API transaccional de Brevo (panel > SMTP & API > API Keys).
# OBLIGATORIA cuando BREVO_HABILITADO=true.
BREVO_API_KEY=

# Remitente verificado en la cuenta de Brevo. Si no está verificado la API
# responde 400 y el correo no sale (la cuenta se crea igual y se puede reenviar).
BREVO_REMITENTE_EMAIL=

# Nombre visible del remitente. Opcional (por defecto "Estación Burger").
BREVO_REMITENTE_NOMBRE=Estación Burger

# Timeout de conexión y de la petición completa. Opcional (5s por defecto).
BREVO_TIMEOUT=5s

# ------------------------------------------------------------------------------
# OpenRouteService (ORS) — rutas del módulo de reparto (delivery)
# ------------------------------------------------------------------------------
# Proveedor de rutas por carretera (Directions), optimización del orden de
# paradas en multientregas (Optimization/VROOM) y geocoding de direcciones.
#
# La clave vive EXCLUSIVAMENTE en el backend. NUNCA se expone al móvil ni se
# define como EXPO_PUBLIC_*: la app pide rutas a nuestra API (/api/v1/delivery),
# y es el backend quien llama a ORS con esta clave.
#
# Alta gratuita y token: https://openrouteservice.org/dev/#/signup
# Los límites del plan gratuito (p. ej. Directions/Optimization/Geocoding por
# día y por minuto) se consultan en tu panel de ORS: "Dashboard > Tokens".
# Déjala vacía en desarrollo si no vas a calcular rutas: los endpoints que la
# requieren responderán 503 en vez de inventar un resultado.
ORS_API_KEY=

# URL base de la API de ORS. Por defecto la instancia pública oficial.
ORS_BASE_URL=https://api.openrouteservice.org

# Timeout (ms) de cada llamada a ORS (conexión + respuesta). 8s por defecto.
ORS_TIMEOUT_MS=8000
